FLASK_SECRET_KEY=

# Use development for local HTTP. Set production for HTTPS deployments.
APP_ENV=development

# Choose "openai", "gemini", or "auto" (prefers OpenAI if both keys exist).
CHAT_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash